@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
:root{--bg:#080d18;--surface:#101a2a;--surface2:#142238;--line:#24334a;--text:#eef4ff;--muted:#91a2ba;--blue:#68a8ff;--cyan:#68e0d1;--green:#42d39a;--amber:#f3bd5d;--red:#ff727c;--radius:18px}
*{box-sizing:border-box}html{background:var(--bg);color-scheme:dark}body{margin:0;background:radial-gradient(ellipse at 75% -15%,#19345b 0,transparent 38%),var(--bg);color:var(--text);font-family:'DM Sans',-apple-system,BlinkMacSystemFont,sans-serif;font-size:14px;min-height:100vh;padding-bottom:calc(82px + env(safe-area-inset-bottom))}
button,input,select,textarea{font:inherit}button{cursor:pointer}.app-shell{max-width:760px;margin:auto;min-height:100vh}.topbar{height:72px;padding:0 18px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #1d2b40;background:#09111feF;position:sticky;top:0;z-index:10;backdrop-filter:blur(18px)}.brand{display:flex;align-items:center;gap:10px}.brand-mark{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(145deg,#28558b,#142a49);color:#a9d2ff;font-size:23px;box-shadow:0 5px 20px #0005}.brand-name{font:700 15px 'Space Grotesk';letter-spacing:1.2px}.brand-name span{color:var(--blue)}.brand-sub{font-size:8px;color:var(--muted);letter-spacing:1.6px;margin-top:3px}.top-actions{display:flex;align-items:center;gap:10px}.mode-pill,.tag,.small-tag{font-size:9px;letter-spacing:.7px;font-weight:700;border-radius:99px;padding:7px 9px;background:#142b31;color:#7fe1c4}.mode-pill i{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--green);margin-right:5px}.icon-btn{border:1px solid var(--line);background:#111d2e;color:var(--text);border-radius:11px;width:36px;height:36px;font-size:19px}
main{padding:22px 16px 24px}.page{display:none;animation:fade .2s ease}.page.active{display:block}@keyframes fade{from{opacity:.4;transform:translateY(4px)}to{opacity:1;transform:none}}h1,h2,h3,p{margin-top:0}h1{font:600 28px 'Space Grotesk';letter-spacing:-.8px;margin:5px 0 4px}h2{font:600 19px 'Space Grotesk';margin:4px 0 0}h3{font:600 15px 'Space Grotesk';margin:0 0 13px}.muted{color:var(--muted);line-height:1.55}.eyebrow{font-size:9px;letter-spacing:1.6px;color:#7e9abc;font-weight:700}.welcome-row{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:18px}.capital-chip{border:1px solid #29496b;background:#11243b;border-radius:14px;padding:10px 12px;min-width:116px}.capital-chip span,.capital-chip strong{display:block}.capital-chip span{font-size:8px;letter-spacing:1px;color:#9ab0cb}.capital-chip strong{font:700 17px 'Space Grotesk';margin-top:5px;color:#fff}.notice{display:flex;gap:11px;padding:13px;border-radius:14px;margin:16px 0 25px;border:1px solid #69502c;background:#2a2115}.notice-icon{flex:none;width:23px;height:23px;border-radius:50%;display:grid;place-items:center;background:#65491f;color:#ffd78d;font-weight:700}.notice strong{font-size:12px;color:#ffe0a7}.notice p{font-size:11px;color:#c5b18c;line-height:1.5;margin:4px 0 0}.section-heading{display:flex;align-items:flex-end;justify-content:space-between;margin:25px 0 12px}.text-btn{border:0;background:none;color:var(--blue);font-weight:700;font-size:11px;padding:5px 0}.small-tag{background:#172438;color:#a8bdd7}.market-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.market-card,.panel{background:linear-gradient(145deg,#121e30,#0f1928);border:1px solid var(--line);border-radius:var(--radius)}.market-card{padding:14px;min-width:0}.market-top{display:flex;justify-content:space-between;align-items:center}.symbol{font:700 13px 'Space Grotesk';letter-spacing:.3px}.market-name{font-size:10px;color:var(--muted);margin-top:3px}.market-price{font:600 18px 'Space Grotesk';margin:15px 0 5px;overflow:hidden;text-overflow:ellipsis}.quote-status{font-size:9px;color:var(--amber);line-height:1.4}.tag{padding:5px 7px;font-size:8px}.tag.amber{background:#352916;color:#f6c76c}.tag.green{background:#12332c;color:#69ddb5}.tag.red{background:#3b2029;color:#ff9299}.panel{padding:16px;margin-bottom:12px}.checklist{display:grid;gap:13px}.checklist label{display:flex;align-items:center;gap:10px;color:#cbd7e8;font-size:12px}.checklist input{accent-color:#64a9ff;width:17px;height:17px}.checklist-foot{font-size:10px;color:#7f93ae;border-top:1px solid var(--line);padding-top:12px;line-height:1.5}.stat-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-bottom:12px}.stat span,.stat small{display:block;color:var(--muted);font-size:10px}.stat strong{display:block;font:600 21px 'Space Grotesk';margin:8px 0 4px}.stat small{font-size:9px}.compact-panel p{font-size:11px;margin:9px 0 0}.row-between{display:flex;align-items:center;justify-content:space-between;gap:10px}.page-head{margin-bottom:20px}.page-head p{font-size:12px;margin:7px 0 0}.toolbar{display:flex;gap:9px;margin-bottom:14px}.toolbar select{flex:1}.watch-list{display:grid;gap:9px;margin-bottom:18px}.watch-row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:14px;border:1px solid var(--line);border-radius:14px;background:#101a2a}.watch-row .right{text-align:right;min-width:0}.watch-row strong{font:600 15px 'Space Grotesk'}.watch-row small{display:block;color:var(--muted);font-size:9px;margin-top:4px}.link-list{display:grid;gap:12px}.link-list a{color:#8fc2ff;text-decoration:none;font-size:12px}.form-panel{display:grid;gap:14px}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}label{display:grid;gap:7px;color:#b9c8db;font-size:11px;font-weight:600}input,select,textarea{width:100%;border:1px solid #2a3b54;background:#0b1422;color:#edf4ff;border-radius:10px;padding:12px;min-height:43px;outline:none}textarea{resize:vertical;line-height:1.5}input:focus,select:focus,textarea:focus{border-color:#609fe8;box-shadow:0 0 0 2px #438ce52b}.primary-btn,.secondary-btn,.danger-btn{border:0;border-radius:11px;padding:12px 15px;font-size:12px;font-weight:700}.primary-btn{background:linear-gradient(100deg,#367ed2,#4c9af0);color:white;box-shadow:0 5px 18px #2462a52c}.secondary-btn{background:#26364b;color:#d9e6f7}.danger-btn{background:#51242d;color:#ffb2b8}.full{width:100%}.field-block{display:grid;gap:8px}.label-row{display:flex;justify-content:space-between;align-items:center}.label-row strong{color:#8fc2ff;font:600 14px 'Space Grotesk'}.range-labels{display:flex;justify-content:space-between;color:var(--muted);font-size:9px}.result-box{background:linear-gradient(110deg,#142f4b,#173b56);border:1px solid #2b5c7c;border-radius:14px;padding:15px;display:grid;gap:5px}.result-box span,.result-box small{font-size:10px;color:#a5bfd7}.result-box strong{font:700 25px 'Space Grotesk';color:#fff}.secondary-result{background:#121f30;border-color:var(--line)}.tiny{font-size:9px;line-height:1.55}.result-panel{border-color:#315c7c}.result-panel h3{margin-bottom:7px}.result-number{font:700 24px 'Space Grotesk';margin:7px 0}.hidden{display:none!important}.stack-list{display:grid;gap:9px}.empty-state{border:1px dashed #30425b;border-radius:14px;padding:20px;text-align:center;color:var(--muted);font-size:11px}.list-card{padding:13px;border:1px solid var(--line);border-radius:14px;background:#101a2a}.list-card p{font-size:10px;color:var(--muted);margin:7px 0 0;line-height:1.5}.button-row{display:flex;gap:9px}.button-row>*{flex:1}.bottom-nav{position:fixed;z-index:20;bottom:0;left:50%;transform:translateX(-50%);width:min(100%,760px);display:grid;grid-template-columns:repeat(6,1fr);padding:8px 6px calc(8px + env(safe-area-inset-bottom));background:#0a1220f2;border-top:1px solid #26364a;backdrop-filter:blur(18px)}.nav-item{border:0;background:none;color:#71849e;display:grid;justify-items:center;gap:3px;padding:3px 0;font-size:9px}.nav-item b{font-size:20px;font-weight:500;line-height:1.1}.nav-item.active{color:#8fc2ff}.nav-item.active b{filter:drop-shadow(0 0 7px #3c8cdd)}dialog{border:1px solid #31445f;background:#101a2a;color:var(--text);border-radius:18px;padding:0;width:min(92vw,420px);max-height:88vh}dialog::backdrop{background:#020611bd;backdrop-filter:blur(4px)}.dialog-card{padding:19px;display:grid;gap:13px}.dialog-card h2{font-size:19px}.dialog-card label{margin:0}.dialog-card .row-between{margin-bottom:3px}#toast{position:fixed;z-index:50;bottom:calc(90px + env(safe-area-inset-bottom));left:50%;transform:translate(-50%,15px);opacity:0;pointer-events:none;background:#e5f1ff;color:#0b1726;border-radius:99px;padding:10px 15px;font-size:11px;font-weight:700;transition:.2s;white-space:nowrap;max-width:90vw;overflow:hidden;text-overflow:ellipsis}#toast.show{opacity:1;transform:translate(-50%,0)}
@media(min-width:650px){main{padding:28px 24px 34px}.market-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.stat-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.bottom-nav{border-left:1px solid #26364a;border-right:1px solid #26364a;border-radius:16px 16px 0 0}.welcome-row{margin-bottom:22px}}
@media(max-width:380px){main{padding:18px 12px}.market-card{padding:11px}.market-price{font-size:16px}.mode-pill{font-size:8px}.form-grid{gap:9px}input,select,textarea{padding:10px}.nav-item{font-size:8px}}

.feed-panel{margin:16px 0 25px;border-color:#29496b;background:linear-gradient(145deg,#12243a,#101a2a)}.feed-panel h3{margin:5px 0 0}.feed-panel p{font-size:11px;margin:10px 0}.feed-meta{font-size:9px;color:#91a2ba;line-height:1.5;margin:8px 0 12px;overflow-wrap:anywhere}.feed-panel .row-between{align-items:flex-start}
